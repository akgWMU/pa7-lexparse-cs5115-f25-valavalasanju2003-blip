    assignment                     shift and go to state 16
    if_statement                   shift and go to state 17
    while_statement                shift and go to state 18
    io_statement                   shift and go to state 19
    compound_statement             shift and go to state 20
    variable                       shift and go to state 21

state 95

    (12) array_type -> ARRAY LBRACKET dim RBRACKET . OF standard_type

    OF              shift and go to state 98


state 96

    (13) dim -> INTNUM DOTDOT . INTNUM

    INTNUM          shift and go to state 99


state 97

    (20) if_statement -> IF expr THEN statement ELSE statement .

    END             reduce using rule 20 (if_statement -> IF expr THEN statement ELSE statement .)
    SEMI            reduce using rule 20 (if_statement -> IF expr THEN statement ELSE statement .)
    ELSE            reduce using rule 20 (if_statement -> IF expr THEN statement ELSE statement .)


state 98

    (12) array_type -> ARRAY LBRACKET dim RBRACKET OF . standard_type
    (10) standard_type -> . INTEGER
    (11) standard_type -> . FLOAT

    INTEGER         shift and go to state 52
    FLOAT           shift and go to state 53

    standard_type                  shift and go to state 100

state 99

    (13) dim -> INTNUM DOTDOT INTNUM .

    RBRACKET        reduce using rule 13 (dim -> INTNUM DOTDOT INTNUM .)


state 100

    (12) array_type -> ARRAY LBRACKET dim RBRACKET OF standard_type .

    SEMI            reduce using rule 12 (array_type -> ARRAY LBRACKET dim RBRACKET OF standard_type .)

